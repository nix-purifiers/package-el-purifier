;;; integration.el --- Locked package integration tests -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: MIT
(require 'ert)
(require 'cl-lib)
(require 'package-el-purifier)
(ert-deftest locked-package-loads ()
  (should package-el-purifier--nix-delivered)
  (should (require 'vertico))
  (should (file-in-directory-p (locate-library "vertico") package-user-dir)))
(ert-deftest refresh-cannot-use-configured-remote-archives ()
  (let ((package-archives '(("remote" . "https://invalid.example/"))))
    (setq package-archive-contents nil)
    (cl-letf (((symbol-function 'url-retrieve-synchronously)
               (lambda (&rest _) (ert-fail "Network access attempted")))
              ((symbol-function 'display-warning)
               (lambda (&rest _) (ert-fail "Refresh produced a warning"))))
      (package-refresh-contents)
      (should (assq 'vertico package-archive-contents)))))
(ert-deftest unlocked-install-fails-before-fetch ()
  (cl-letf (((symbol-function 'url-retrieve-synchronously)
             (lambda (&rest _) (ert-fail "Network access attempted"))))
    (should-error (package-install 'not-in-this-lock) :type 'user-error)))
(ert-deftest native-plugin-missing-lock-keeps-impure-operation ()
  (let ((package-el-purifier-directory (make-temp-file "unlocked-emacs-" t))
        (package-el-purifier--archive nil)
        (warnings nil))
    (unwind-protect
        (cl-letf (((symbol-function 'display-warning)
                   (lambda (_ message &rest _) (push message warnings))))
          (package-el-purifier-activate)
          (should-not package-el-purifier--archive)
          (should (string-match-p "impure" (car warnings))))
      (delete-directory package-el-purifier-directory t))))
